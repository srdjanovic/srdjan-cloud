---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts, formatDate, readingTime } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Blog"
  description="Writing on cloud operations, Kubernetes, BSI C5 compliance, chaos engineering, and observability at scale."
>
  <Nav />

  <main class="blog-main">
    <div class="container">
      <header class="page-header">
        <p class="page-header__tag">// blog</p>
        <h1 class="page-header__title">Writing.</h1>
        <p class="page-header__lead">
          Notes on cloud infrastructure, reliability, and the operational reality behind the architecture diagrams.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="empty">No posts published yet.</p>
      ) : (
        <div class="posts-grid" aria-label="Blog posts">
          {posts.map(p => (
            <a href={`/blog/${p.slug}/`} class="card post-card">
              <div class="post-card__meta">
                <time class="post-card__date" datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
                <span class="post-card__tag">{readingTime(p.body)} min read</span>
              </div>
              <h2 class="post-card__title">{p.data.title}</h2>
              <p class="post-card__excerpt">{p.data.excerpt}</p>
              <span class="post-card__arrow">Read more →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .blog-main { padding-top: var(--nav-h); padding-bottom: 5rem; }

  .empty { color: var(--muted); padding: 2rem 0; }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    display: block;
    padding: 1.75rem 2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.2s;
  }
  .post-card:hover { transform: translateY(-2px); opacity: 1; }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .post-card__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .post-card__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--green);
    background: rgba(57,255,20,0.07);
    border: 1px solid rgba(57,255,20,0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-card__title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
    transition: color 0.2s;
  }
  .post-card:hover .post-card__title { color: var(--accent); }
  .post-card__excerpt {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }
  .post-card__arrow {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .post-card:hover .post-card__arrow { opacity: 1; transform: translateX(0); }
</style>
